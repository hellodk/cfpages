---
import { getCollection } from 'astro:content';
import { toPost } from '../../utils/toPost';
import ThemeCard from '../../components/theme/ThemeCard.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = toPost(allPosts[0]);
const gridPosts = allPosts.slice(1, 5).map(toPost);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Bento Grid</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Open+Sans:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />
  <style>
    /* ================= THEME: Bento Grid ================= */
    .theme-showcase--bento {
      --ts-bg: #f7f6f2; --ts-text: #222226; --ts-muted: #6e737d;
      --ts-inverted: #0f172a; --ts-accent: #2563eb; --ts-border: #e3e5eb;
      --ts-nav-bg: #f7f6f2; --ts-radius: 14px;
      --ts-font-body: 'Merriweather', Georgia, serif;
      --ts-font-head: 'Open Sans', -apple-system, sans-serif;
      background: var(--ts-bg); color: var(--ts-text);
      font-family: var(--ts-font-body); line-height: 1.7;
    }
    .theme-showcase--bento * { box-sizing: border-box; }
    .theme-showcase--bento .ts-nav {
      display: flex; align-items: center; justify-content: center;
      padding: 16px 24px; position: sticky; top: 0; z-index: 50;
    }
    .theme-showcase--bento .ts-nav__center { display: flex; align-items: center; gap: 30px; }
    .theme-showcase--bento .ts-nav__logo {
      font-family: 'JetBrains Mono', monospace; font-size: 1.15rem; font-weight: 800;
      color: var(--ts-inverted); text-decoration: none; letter-spacing: -0.5px;
    }
    .theme-showcase--bento .ts-nav__logo em { color: var(--ts-accent); font-style: normal; }
    .theme-showcase--bento .ts-nav__links { display: flex; gap: 22px; align-items: center; }
    .theme-showcase--bento .ts-nav__links a {
      color: var(--ts-text); text-decoration: none; font-family: var(--ts-font-head);
      font-size: 0.85rem; font-weight: 700; letter-spacing: 0.02em;
      transition: color 0.15s;
    }
    .theme-showcase--bento .ts-nav__links a:hover { color: var(--ts-accent); }
    .theme-showcase--bento .ts-nav__icon { color: var(--ts-muted); transition: color 0.15s; }
    .theme-showcase--bento .ts-nav__icon:hover { color: var(--ts-accent); }
    .theme-showcase--bento .ts-hero {
      position: relative; margin: -24px -24px 32px; min-height: 52vh;
      background: #e9e7dc;
      display: flex; align-items: center; justify-content: center;
      padding: 80px 24px; text-align: center; border-bottom: 1px solid var(--ts-border);
    }
    .theme-showcase--bento .ts-shade { position: absolute; inset: 0; background: rgba(15,23,42,0.03); pointer-events: none; }
    .theme-showcase--bento .ts-hero-inner { position: relative; z-index: 1; max-width: 760px; }
    .theme-showcase--bento .ts-hero-inner h1 {
      font-family: var(--ts-font-body); font-size: clamp(1.75rem, 4.5vw, 2.7rem);
      font-weight: 400; font-style: italic; color: var(--ts-inverted); line-height: 1.18; margin: 0 0 16px;
      letter-spacing: 0.005em;
    }
    .theme-showcase--bento .ts-sub {
      font-family: var(--ts-font-head); font-size: clamp(1.05rem, 2.2vw, 1.4rem);
      font-weight: 600; color: var(--ts-accent); margin: 0 auto 12px; max-width: 42em; line-height: 1.35;
    }
    .theme-showcase--bento .ts-scale {
      font-family: var(--ts-font-body); font-size: 1.05rem; color: var(--ts-text);
      margin: 0 auto 20px; max-width: 70ch; line-height: 1.6;
    }
    .theme-showcase--bento .ts-cta {
      display: inline-block; font-family: var(--ts-font-head); font-size: 0.9rem;
      font-weight: 700; color: var(--ts-bg); background: var(--ts-inverted);
      padding: 11px 24px; text-decoration: none; border-radius: 999px;
      transition: transform 0.15s;
    }
    .theme-showcase--bento .ts-cta:hover { transform: translateY(-2px); }
    .theme-showcase--bento .ts-featured { max-width: 1180px; margin: 0 auto 44px; padding: 0 24px; }
    .theme-showcase--bento .ts-grid { max-width: 1180px; margin: 0 auto 36px; padding: 0 24px; }
    .theme-showcase--bento .ts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 32px; }
    @media (max-width: 700px) { .theme-showcase--bento .ts-grid { grid-template-columns: 1fr; } }
    .theme-showcase--bento .ts-card { background: var(--ts-bg); border-radius: var(--ts-radius); overflow: hidden; border: 1px solid var(--ts-border);
      transition: transform 0.3s, box-shadow 0.3s; display: flex; flex-direction: column;
    }
    .theme-showcase--bento .ts-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.08); }
    .theme-showcase--bento .ts-card:nth-child(1):hover { transform: none; }
    .theme-showcase--bento .ts-card__media { position: relative; display: block; overflow: hidden; flex-shrink: 0; }
    .theme-showcase--bento .ts-card__media img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; transition: transform 0.5s; }
    .theme-showcase--bento .ts-card:hover .ts-card__img { transform: scale(1.03); }
    .theme-showcase--bento .ts-card__media::after {
      content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(15,23,42,0.7) 100%); opacity: 0.85;
    }
    .theme-showcase--bento .ts-card__pill {
      position: absolute; top: 14px; left: 14px; z-index: 1;
      font-family: var(--ts-font-head); font-size: 0.65rem; font-weight: 800; text-transform: uppercase;
      letter-spacing: 0.06em; color: #fff; padding: 4px 11px; border-radius: 999px; background: var(--ts-tag);
      box-shadow: 0 2px 10px rgba(37,99,235,0.35);
    }
    .theme-showcase--bento .ts-card__body { padding: 22px 24px; flex: 1; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .theme-showcase--bento .ts-card__title { font-family: var(--ts-font-head); font-size: 1.1rem; font-weight: 800; line-height: 1.3; margin: 0; }
    .theme-showcase--bento .ts-card__title a { color: var(--ts-inverted); text-decoration: none; }
    .theme-showcase--bento .ts-card__title a:hover { color: var(--ts-accent); }
    .theme-showcase--bento .ts-card__excerpt { font-family: var(--ts-font-body); font-size: 0.92rem; color: var(--ts-muted); line-height: 1.6; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .theme-showcase--bento .ts-card__foot { display: flex; flex-direction: column; gap: 10px; margin-top: auto; }
    .theme-showcase--bento .ts-card__meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-family: var(--ts-font-head); font-size: 0.72rem; color: var(--ts-muted); }
    .theme-showcase--bento .ts-card__avatar { border-radius: 50%; width: 20px; height: 20px; object-fit: cover; }
    .theme-showcase--bento .ts-card__tags { display: flex; gap: 6px; flex-wrap: wrap; }
    .theme-showcase--bento .ts-footer { max-width: 1180px; margin: 0 auto 48px; padding: 0 24px; text-align: center; font-size: 0.85rem; color: var(--ts-muted); }
    .theme-showcase--bento .ts-footer a { color: var(--ts-accent); text-decoration: none; }

    /* ---- featured card (overlay) ---- */
    .theme-showcase--bento .ts-card--featured {
      position: relative; display: block; border: 1px solid var(--ts-border);
    }
    .theme-showcase--bento .ts-card--featured .ts-card__media { display: block; }
    .theme-showcase--bento .ts-card--featured .ts-card__media img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
    .theme-showcase--bento .ts-card--featured .ts-card__media::after {
      background: linear-gradient(180deg, transparent 35%, rgba(15,23,42,0.85) 100%);
    }
    .theme-showcase--bento .ts-card--featured .ts-card__pill {
      position: absolute; top: 14px; left: 14px; z-index: 1;
      font-family: var(--ts-font-head); font-size: 0.65rem; font-weight: 800;
      text-transform: uppercase; letter-spacing: 0.06em; color: #fff;
      padding: 4px 11px; border-radius: 999px; background: var(--ts-accent);
      box-shadow: 0 2px 10px rgba(37,99,235,0.35);
    }
    .theme-showcase--bento .ts-card--featured .ts-card__overlay-title {
      position: absolute; inset: 0; padding: 24px;
      font-family: var(--ts-font-head); font-size: 1.5rem; font-weight: 800;
      line-height: 1.25; color: #fff;
      text-shadow: 0 1px 12px rgba(0,0,0,0.4);
      display: flex; align-items: flex-end;
    }
    .theme-showcase--bento .ts-card--featured .ts-card__body { display: none; }

  </style>
</head>
<body>
  <div style="background:#f1f5f9; padding:16px; border-bottom:1px solid #cbd5e1; margin-bottom:20px;">
    <h2 style="margin:0 0 8px;">Bento Grid</h2>
    <p style="margin:0; color:#475569;">Validating standalone theme layout — this section renders alone.</p>
  </div>
<section class="theme-showcase theme-showcase--bento" data-theme="bento" data-name="Bento Grid">
      <nav class="ts-nav"><div class="ts-nav__center">
        <a href="/" class="ts-nav__logo">hello<em>dk</em></a>
        <div class="ts-nav__links">
          <a href="/">Blog</a>
          <a href="/tag/devops">DevOps</a>
          <a href="/tag/kubernetes">Kubernetes</a>
          <a href="/about">About</a>
          <a href="/newsletter">Newsletter</a>
        </div>
        <a href="/search" class="ts-nav__icon" aria-label="Search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
      </div></nav>
      <header class="ts-hero"><div class="ts-shade"></div>
        <div class="ts-hero-inner">
          <h1>{featured.title}</h1>
          <p class="ts-sub">Deepak Gupta · DevOps · SRE · Homelab</p>
          <p class="ts-scale">Securing and running production systems across banking, gaming and e-commerce since 2011.</p>
          <a href={`/${featured.slug}`} class="ts-cta">Read the story →</a>
        </div>
      </header>
      <div class="ts-featured">
        <ThemeCard slug={featured.slug} title={featured.title} description={featured.description} date={featured.date} tags={featured.tags} cover={featured.cover} readingTime={featured.readingTime} featured={true} />
      </div>
      <div class="ts-grid">
        {gridPosts.map(p => <ThemeCard slug={p.slug} title={p.title} description={p.description} date={p.date} tags={p.tags} cover={p.cover} readingTime={p.readingTime} />)}
      </div>
      <footer class="ts-footer">© 2026 Deepak Gupta · <a href="/feed.xml">RSS</a> · <a href="/about">About</a></footer>
    </section>

    <!-- Theme 4: Monochrome --------------------------------------------------- -->
</body>
</html>
