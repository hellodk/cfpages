---
import { getCollection } from 'astro:content';
import { toPost } from '../../utils/toPost';
import ThemeCard from '../../components/theme/ThemeCard.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = toPost(allPosts[0]);
const gridPosts = allPosts.slice(1, 5).map(toPost);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Modern Dark</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Open+Sans:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />
  <style>
    /* ================= THEME: Modern Dark ================= */
    .theme-showcase--dark {
      --ts-bg: #0e1116; --ts-text: #c9d1d9; --ts-muted: #8b949e;
      --ts-inverted: #e6edf3; --ts-accent: #2dd4bf; --ts-border: #30363d;
      --ts-nav-bg: #0e1116; --ts-radius: 12px;
      --ts-font-body: 'Inter', -apple-system, sans-serif;
      --ts-font-head: 'Inter', -apple-system, sans-serif;
      background: var(--ts-bg); color: var(--ts-text);
      font-family: var(--ts-font-body); line-height: 1.6;
    }
    .theme-showcase--dark * { box-sizing: border-box; }
    .theme-showcase--dark .ts-nav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 24px; height: 60px; background: var(--ts-nav-bg);
      border-bottom: 1px solid var(--ts-border); position: sticky; top: 0; z-index: 50;
    }
    .theme-showcase--dark .ts-nav__logo {
      font-family: 'JetBrains Mono', monospace; font-size: 1.05rem; font-weight: 700;
      color: #fff; text-decoration: none;
    }
    .theme-showcase--dark .ts-nav__logo em { color: var(--ts-accent); font-style: normal; }
    .theme-showcase--dark .ts-nav__links { display: flex; gap: 20px; align-items: center; }
    .theme-showcase--dark .ts-nav__links a {
      color: #d0d7de; text-decoration: none; font-family: var(--ts-font-head);
      font-size: 0.85rem; font-weight: 600; letter-spacing: 0.02em;
      padding: 6px 10px; border-radius: 8px; transition: all 0.15s;
    }
    .theme-showcase--dark .ts-nav__links a:hover { color: #fff; background: rgba(255,255,255,0.06); }
    .theme-showcase--dark .ts-nav__icon { color: #8b949e; transition: color 0.15s; }
    .theme-showcase--dark .ts-nav__icon:hover { color: #fff; }
    .theme-showcase--dark .ts-hero {
      position: relative; margin: -24px -24px 30px; min-height: 50vh;
      display: flex; align-items: center; justify-content: center;
      padding: 70px 24px; text-align: center;
      background:
        radial-gradient(ellipse at 50% -20%, rgba(45,212,191,0.14) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(37,99,235,0.12) 0%, transparent 50%),
        #0e1116;
      border-bottom: 1px solid var(--ts-border);
    }
    .theme-showcase--dark .ts-shade { position: absolute; inset: 0; background: rgba(0,0,0,0.35); pointer-events: none; }
    .theme-showcase--dark .ts-hero-inner { position: relative; z-index: 1; max-width: 720px; }
    .theme-showcase--dark .ts-hero-inner h1 {
      font-family: var(--ts-font-body); font-size: clamp(1.6rem, 4.5vw, 2.6rem);
      font-weight: 700; color: #fff; line-height: 1.22; margin: 0 0 14px;
      letter-spacing: -0.02em; text-shadow: 0 2px 16px rgba(0,0,0,0.5);
    }
    .theme-showcase--dark .ts-sub {
      font-family: var(--ts-font-body); font-size: clamp(1rem, 2.2vw, 1.3rem);
      color: rgba(226,232,240,0.85); margin: 0 auto 12px; max-width: 40em; line-height: 1.45;
    }
    .theme-showcase--dark .ts-scale {
      font-family: var(--ts-font-body); font-size: 0.95rem; color: rgba(226,232,240,0.7);
      margin: 0 auto 16px; max-width: 68ch; line-height: 1.6;
    }
    .theme-showcase--dark .ts-cta {
      display: inline-block; font-family: var(--ts-font-head); font-size: 0.9rem;
      font-weight: 700; color: #042f2a; background: var(--ts-accent);
      padding: 10px 22px; text-decoration: none; border-radius: 999px;
      transition: transform 0.15s;
    }
    .theme-showcase--dark .ts-cta:hover { transform: translateY(-1px); }
    .theme-showcase--dark .ts-featured { max-width: 1120px; margin: 0 auto 42px; padding: 0 24px; }
    .theme-showcase--dark .ts-grid { max-width: 1120px; margin: 0 auto 32px; padding: 0 24px; }
    .theme-showcase--dark .ts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 28px; }
    @media (min-width: 900px) {
      .theme-showcase--dark .ts-grid .ts-card:nth-child(1) { grid-column: span 2; }
    }
    @media (max-width: 600px) { .theme-showcase--dark .ts-grid { grid-template-columns: 1fr; } }
    .theme-showcase--dark .ts-card { background: var(--ts-bg); border-radius: var(--ts-radius); overflow: hidden; border: 1px solid var(--ts-border);
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s; display: flex; flex-direction: column;
    }
    .theme-showcase--dark .ts-card:hover { transform: translateY(-3px); border-color: var(--ts-accent); box-shadow: 0 12px 28px rgba(0,0,0,0.4); }
    .theme-showcase--dark .ts-card:nth-child(1):hover { transform: none; }
    .theme-showcase--dark .ts-card__media { position: relative; display: block; overflow: hidden; flex-shrink: 0; }
    .theme-showcase--dark .ts-card__media img { width: 100%; aspect-ratio: 16/10; object-fit: cover; display: block; transition: transform 0.4s; }
    .theme-showcase--dark .ts-card:hover .ts-card__img { transform: scale(1.04); }
    .theme-showcase--dark .ts-card__media::after {
      content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(9,10,11,0.55) 100%); opacity: 0.85;
    }
    .theme-showcase--dark .ts-card__pill {
      position: absolute; top: 12px; left: 12px; z-index: 1;
      font-family: var(--ts-font-head); font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.06em; color: #042f2a; padding: 3px 10px; border-radius: 3px; background: var(--ts-tag);
      box-shadow: 0 2px 8px rgba(0,0,0,0.35);
    }
    .theme-showcase--dark .ts-card__body { padding: 20px 22px; flex: 1; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
    .theme-showcase--dark .ts-card__title { font-family: var(--ts-font-head); font-size: 1.05rem; font-weight: 700; line-height: 1.35; margin: 0; }
    .theme-showcase--dark .ts-card__title a { color: var(--ts-inverted); text-decoration: none; }
    .theme-showcase--dark .ts-card__title a:hover { color: var(--ts-accent); }
    .theme-showcase--dark .ts-card__excerpt { font-family: var(--ts-font-body); font-size: 0.88rem; color: #8b949e; line-height: 1.6; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .theme-showcase--dark .ts-card__foot { display: flex; flex-direction: column; gap: 10px; margin-top: auto; }
    .theme-showcase--dark .ts-card__meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-family: var(--ts-font-head); font-size: 0.72rem; color: #4b5563; }
    .theme-showcase--dark .ts-card__avatar { border-radius: 50%; width: 20px; height: 20px; object-fit: cover; }
    .theme-showcase--dark .ts-card__tags { display: flex; gap: 6px; flex-wrap: wrap; }
    .theme-showcase--dark .ts-footer { max-width: 1120px; margin: 0 auto 48px; padding: 0 24px; text-align: center; font-size: 0.85rem; color: #4b5563; }
    .theme-showcase--dark .ts-footer a { color: var(--ts-accent); text-decoration: none; }

    /* ---- featured card (horizontal) ---- */
    .theme-showcase--dark .ts-card--featured {
      display: grid; grid-template-columns: 52% 48%; gap: 28px;
    }
    .theme-showcase--dark .ts-card--featured .ts-card__media { display: block; }
    .theme-showcase--dark .ts-card--featured .ts-card__media img { width: 100%; height: 320px; object-fit: cover; }
    .theme-showcase--dark .ts-card--featured .ts-card__overlay-title {
      font-family: var(--ts-font-head); font-size: 1.45rem; font-weight: 700; color: #e6edf3; margin-top: 8px;
    }
    .theme-showcase--dark .ts-card--featured .ts-card__body { padding: 28px 26px; }
    @media (max-width: 899px) {
      .theme-showcase--dark .ts-card--featured .ts-card__media img { width: 100%; height: 240px; }
      .theme-showcase--dark .ts-card--featured { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div style="background:#f1f5f9; padding:16px; border-bottom:1px solid #cbd5e1; margin-bottom:20px;">
    <h2 style="margin:0 0 8px;">Modern Dark</h2>
    <p style="margin:0; color:#475569;">Validating standalone theme layout — this section renders alone.</p>
  </div>
<section class="theme-showcase theme-showcase--dark" data-theme="dark" data-name="Modern Dark">
      <nav class="ts-nav">
        <a href="/" class="ts-nav__logo">hello<em>dk</em></a>
        <div class="ts-nav__links">
          <a href="/">Blog</a>
          <a href="/tag/devops">DevOps</a>
          <a href="/tag/kubernetes">Kubernetes</a>
          <a href="/about">About</a>
          <a href="/newsletter">Newsletter</a>
          <a href="/search" class="ts-nav__icon" aria-label="Search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </a>
        </div>
      </nav>
      <header class="ts-hero"><div class="ts-shade"></div>
        <div class="ts-hero-inner">
          <h1>{featured.title}</h1>
          <p class="ts-sub">Deepak Gupta · DevOps · SRE · Homelab</p>
          <p class="ts-scale">Securing and running production systems across banking, gaming and e-commerce since 2011.</p>
          <a href={`/${featured.slug}`} class="ts-cta">Read the story →</a>
        </div>
      </header>
      <div class="ts-featured">
        <ThemeCard slug={featured.slug} title={featured.title} description={featured.description} date={featured.date} tags={featured.tags} cover={featured.cover} readingTime={featured.readingTime} featured={true} />
      </div>
      <div class="ts-grid">
        {gridPosts.map(p => <ThemeCard slug={p.slug} title={p.title} description={p.description} date={p.date} tags={p.tags} cover={p.cover} readingTime={p.readingTime} />)}
      </div>
      <footer class="ts-footer">© 2026 Deepak Gupta · <a href="/feed.xml">RSS</a> · <a href="/about">About</a></footer>
    </section>

    <!-- Theme 3: Bento Grid --------------------------------------------------- -->
</body>
</html>
